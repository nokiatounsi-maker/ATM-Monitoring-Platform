<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtmMonitoring.Core\AtmMonitoring.Core.csproj" />
  </ItemGroup>

  <!-- Filter out Microsoft.AspNetCore.OpenApi.SourceGenerators to avoid compilation issues in .NET 8 -->
  <Target Name="DisableCompileTimeOpenApiXmlGenerator" BeforeTargets="ResolveAnalyzers;BeforeCompile;ResolveReferences">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::new('%(Identity)').Contains('Microsoft.AspNetCore.OpenApi'))" />
    </ItemGroup>
  </Target>

</Project>
